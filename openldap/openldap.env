: ${INFO:="OpenLDAP"}

T=$APN-$V.tgz
S=$SRC/$APN-$V

do_init(){
  [[ "$V" =~ ^2.[456] ]] && APT_ADD+=("unixodbc-dev")

  apt update
  apt -y install libdb-dev libssl-dev "${APT_ADD[@]}"
}

do_pull(){
  curl $SRC_OPT -O $SRC_URI/sw/oss/$APN/src/$T
}

do_unpack(){
  tar xvf $T
}

do_configure(){
  [[ "$V" =~ ^2.[4]   ]] && CFG_ADD+=("--enable-shell")
  [[ "$V" =~ ^2.[456] ]] && CFG_ADD+=("--enable-sql")

  ./configure --prefix=$DST/$APN-$V \
    --with-tls=openssl \
    --enable-overlays \
    --enable-dnssrv \
    --enable-ldap \
    --enable-meta \
    --enable-null \
    --enable-passwd \
    "${CFG_ADD[@]}"
}

do_build(){
  make depend
  make
}

do_install(){
  make install
  ln -snfvr $DST/$APN{-$V,}
}

do_verify(){
  $DST/$APN/libexec/slapd -VVV || true
}

do_save(){
  cd $DST
  tar cvf $SRC/$APN-$V-$OSN-$OSA.tar $APN-$V
  gzip -f $SRC/$APN-$V-$OSN-$OSA.tar
}

do_push(){
  scp -q $SRC/$APN-$V-$OSN-$OSA.tar.gz $DST_URI/sw/oss/$APN/bin/
}
