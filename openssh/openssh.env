INFO="OpenSSH"

T=$APN-$V.tar.gz
S=$SRC/$APN-$V

PATH=$DST/$APN/bin:$PATH

do_init(){
  apt update
  apt -y install libssl-dev libpam0g-dev
}

do_pull(){
  curl $SRC_OPT -O $SRC_URI/sw/oss/$APN/src/$T
}

do_unpack(){
  tar xvf $T
}

do_configure(){
  ./configure --prefix=$DST/$APN-$V \
     --with-pam
}

do_build(){
  make
}

do_install(){
  make install
  ln -snfvr $DST/$APN{-$V,}
}

do_verify(){
  ssh -V
}

do_save(){
  cd $DST
  tar cvf $SRC/$APN-$V-$OSN-$OSA.tar $APN-$V
  gzip -f $SRC/$APN-$V-$OSN-$OSA.tar
}

do_push(){
  scp -q $SRC/$APN-$V-$OSN-$OSA.tar.gz $DST_URI/sw/oss/$APN/bin/
}
