INFO="Secure shell"

T=$APN-$V.tar.gz
S=$SRC/$APN-$V

do_init(){
  apt update
  apt -y install libssl-dev libpam0g-dev
}

do_pull(){
  curl $SRC_OPT -O $SRC_URI/sw/oss/$APN/src/$T
}

do_unpack(){
  tar xvf $T
}

do_config(){
  cd $S
  ./configure --prefix=$DST/$APN-$V \
     --with-pam
}

do_build(){
  cd $S
  make
}

do_install(){
  cd $S
  make install
  ln -snfvr $DST/$APN{-$V,}
  $DST/$APN/bin/ssh -V
}

do_save(){
  cd $DST
  tar cvf $SRC/$APN-$V-$OSN-$OSA.tar $APN-$V
  gzip -f $SRC/$APN-$V-$OSN-$OSA.tar
  ls -ogh --time-style=long $SRC/$APN-$V-$OSN-$OSA.tar.gz
}

do_push(){
  scp -q $SRC/$APN-$V-$OSN-$OSA.tar.gz $DST_URI/sw/oss/$APN/bin/
}
