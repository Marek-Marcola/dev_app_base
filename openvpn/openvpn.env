: ${INFO:="OpenVPN"}

: ${T:=$APN-$V.tar.gz}
: ${S:=$SRC/$APN-$V}

PATH=$DST/$APN/sbin:$PATH

do_init(){
  apt update
  apt install -y gcc cmake pkg-config
  apt install -y liblzo2-dev
  apt install -y libpam0g-dev libsystemd-dev
  apt install -y libcap-ng-dev liblz4-dev
  apt install -y libssl-dev systemd-dev
}

do_pull(){
  curl $SRC_OPT -O $SRC_URI/sw/oss/$APN/src/$T
}

do_unpack(){
  tar xvf $T
}

do_configure(){
  ./configure --prefix=$DST/$APN-$V \
    --enable-systemd \
    --disable-dco
}

do_build(){
  make
}

do_install(){
  make install
  ln -snfvr $DST/$APN{-$V,}

  mkdir -v $DST/$APN/bin
  cp -v sample/sample-scripts/verify-cn $DST/$APN/bin
}

do_verify(){
  openvpn --version | grep -i compile | fold -w 60 -s
}

do_save(){
  cd $DST
  tar cvf $SRC/$APN-$V-$OSN-$OSA.tar $APN-$V
  gzip -f $SRC/$APN-$V-$OSN-$OSA.tar
}

do_push(){
  scp -q $SRC/$APN-$V-$OSN-$OSA.tar.gz $DST_URI/sw/oss/$APN/bin/
}
