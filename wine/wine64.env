: ${INFO:="Wine64"}

T=wine-$V.tar.xz
S=$SRC/wine-$V

PATH=$DST/$APN/bin:$PATH

do_init(){
  apt update
  apt install -y libwayland-dev
  apt install -y libxkbregistry-dev
  apt install -y libvulkan-dev
  apt install -y libfontconfig-dev
  apt install -y libpcap-dev
  apt install -y libx11-dev
  apt install -y libxrandr-dev
  apt install -y libxext-dev
  apt install -y libxfixes-dev
  apt install -y libxi-dev
  apt install -y libxinerama-dev
  apt install -y libxcursor-dev
  apt install -y libxxf86vm-dev
  apt install -y libxcomposite-dev
  apt install -y opencl-c-headers
  apt install -y libavcodec-dev
  apt install -y libpulse-dev
  apt install -y libopengl-dev
  apt install -y libavformat-dev
  apt install -y libcups2-dev
  apt install -y libv4l-dev
  apt install -y libegl-dev
  apt install -y ocl-icd-opencl-dev
  apt install -y libgstreamer1.0-dev
  apt install -y flex bison
  apt install -y mingw-w64
  apt install -y libgnutls28-dev
}

do_pull(){
  curl $SRC_OPT -O $SRC_URI/sw/oss/wine/src/$T
}

do_unpack(){
  tar xvf $T
}

do_configure(){
  ./configure --prefix=$DST/$APN-$V \
     --enable-archs=i386,x86_64
}

do_build(){
  make depend
  make -j$(nproc)
}

do_install(){
  make install
  ln -snfvr $DST/$APN{-$V,}
}

do_verify(){
  wine --version
}

do_save(){
  cd $DST
  tar cvf $SRC/$APN-$V-$OSN-$OSA.tar $APN-$V
  gzip -f $SRC/$APN-$V-$OSN-$OSA.tar
}

do_push(){
  scp -q $SRC/$APN-$V-$OSN-$OSA.tar.gz $DST_URI/sw/oss/wine/bin/
}
