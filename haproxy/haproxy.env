: ${INFO:="HAProxy"}

: ${T:=$APN-$V.tar.gz}
: ${S:=$SRC/$APN-$V}

PATH=$DST/$APN/sbin:$PATH

do_init(){
  if [[ "$OSN" =~ ^debian ]]; then
    apt update
    apt -y install libssl-dev libsystemd-dev liblua5.4-dev libpcre2-dev zlib1g-dev
  fi
}

do_pull(){
  curl $SRC_OPT -O $SRC_URI/sw/oss/$APN/src/$T
}

do_unpack(){
  tar xvf $T
}

do_build(){
  make clean
  make -j $(nproc) \
    TARGET=linux-glibc \
    USE_OPENSSL=1 \
    USE_QUIC=1 \
    USE_LUA=1 \
    USE_PCRE2=1 \
    USE_ZLIB=1 \
    USE_PROMEX=1 \
    USE_NS=1 \
    DEFINE=-std=gnu99 \
    V=1
}

do_install(){
  make install PREFIX=$DST/$APN-$V
  ln -snfvr $DST/$APN{-$V,}
}

do_verify(){
  haproxy -vv
}

do_save(){
  cd $DST
  tar cvf $SRC/$APN-$V-$OSN-$OSA.tar $APN-$V
  gzip -f $SRC/$APN-$V-$OSN-$OSA.tar
}

do_push(){
  scp -q $SRC/$APN-$V-$OSN-$OSA.tar.gz $DST_URI/sw/oss/$APN/bin/
}
