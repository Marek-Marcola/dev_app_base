INFO="NGINX HTTP web server"

T=nginx-$V.tar.gz
S=$SRC/nginx-$V

PATH=$DST/$APN/sbin:$PATH

do_init(){
  apt update
  apt install -y libpcre2-dev libssl-dev zlib1g-dev
  apt install -y libyajl-dev libpcre2-dev libxml2-dev libcurl4-openssl-dev
  apt install -y liblmdb-dev libgeoip-dev liblua5.4-dev libxml2-dev libxslt1-dev

  curl $SRC_OPT $SRC_URI/sw/oss/modsecurity/bin/modsecurity-$VER_MODSECURITY-$OSN-$OSA.tar.gz | tar xzf - -C $DST
  ln -snfvr $DST/modsecurity{-$VER_MODSECURITY,}
}

do_pull(){
  curl $SRC_OPT -O $SRC_URI/sw/oss/$APN/src/$T
  curl $SRC_OPT $SRC_URI/sw/oss/$APN/src/nginx-dav-ext-module-$VER_MODULE_DAV_EXT.tar.gz | tar xzf -
  curl $SRC_OPT $SRC_URI/sw/oss/$APN/src/ngx-fancyindex-$VER_MODULE_FANCYINDEX.tar.gz | tar xzf -
  curl $SRC_OPT $SRC_URI/sw/oss/$APN/src/headers-more-nginx-module-$VER_MODULE_HEADERS_MORE.tar.gz | tar xzf -
  curl $SRC_OPT $SRC_URI/sw/oss/modsecurity/src/ModSecurity-nginx-v$VER_MODSECURITY_NGINX.tar.gz | tar xzf -
}

do_unpack(){
  tar xvf $T
}

do_patch(){
  sed -i.b$(date +%y%m%d) \
    -e '/#define NGX_HTTP_AUTOINDEX_PREALLOCATE/{s/50/80/}' \
    -e '/#define NGX_HTTP_AUTOINDEX_NAME_LEN/{s/50/80/}' \
    src/http/modules/ngx_http_autoindex_module.c

  grep '#define NGX_HTTP_AUTOINDEX_[P,N]' src/http/modules/ngx_http_autoindex_module.c
}

do_configure(){
  ./configure --prefix=$DST/$APN-$V \
    --with-http_ssl_module \
    --with-http_v2_module \
    --with-http_realip_module \
    --with-http_addition_module \
    --with-http_auth_request_module \
    --with-http_stub_status_module \
    --with-http_sub_module \
    --with-http_dav_module \
    --with-mail \
    --with-mail_ssl_module \
    --with-stream \
    --with-stream_ssl_module \
    --with-stream_realip_module \
    --http-client-body-temp-path=temp/client_body_temp \
    --http-proxy-temp-path=temp/proxy_temp \
    --http-fastcgi-temp-path=temp/fastcgi_temp \
    --http-uwsgi-temp-path=temp/uwsgi_temp \
    --http-scgi-temp-path=temp/scgi_temp \
    --with-pcre \
    --with-debug \
    --add-module=../ModSecurity-nginx-v$VER_MODSECURITY_NGINX \
    --add-module=../nginx-dav-ext-module-$VER_MODULE_DAV_EXT \
    --add-module=../ngx-fancyindex-$VER_MODULE_FANCYINDEX \
    --add-module=../headers-more-nginx-module-$VER_MODULE_HEADERS_MORE \
    --build="modsecurity/$VER_MODSECURITY,modsecurity-nginx/$VER_MODSECURITY_NGINX"
}

do_build(){
  make
}

do_install(){
  make install
  ln -snfvr $DST/$APN{-$V,}

  mkdir -pv $DST/$APN/share/man/man8
  cp -v objs/nginx.8 $DST/$APN/share/man/man8
}

do_verify(){
  nginx -V 2>&1 | sed 's/--/\n  --/g'
}

do_save(){
  cd $DST
  tar cvf $SRC/$APN-$V-$OSN-$OSA.tar $APN-$V
  gzip -f $SRC/$APN-$V-$OSN-$OSA.tar
}

do_push(){
  scp -q $SRC/$APN-$V-$OSN-$OSA.tar.gz $DST_URI/sw/oss/$APN/bin/
}
