: ${INFO:="PHP"}

: ${T:=php-$V.tar.gz}
: ${S:=$SRC/php-$V}

PATH=$DST/$APN-$V/bin:$PATH

do_init(){
  if [[ "$OSN" =~ ^debian ]]; then
    apt update
    apt install -y bison libxml2-dev gcc libtool lbzip2 zlib1g-dev libsystemd-dev
    apt install -y libpq-dev libssl-dev libldap2-dev
    apt install -y libjpeg62-turbo-dev libfreetype-dev libpng-dev
    apt install -y libicu-dev libcurl4-openssl-dev libsnmp-dev libgmp-dev libacl1-dev libsqlite3-dev xz-utils
    apt install -y libzip-dev libonig-dev apache2-dev libbz2-dev
    apt install -y pkg-config
  fi
}

do_pull(){
  curl $SRC_OPT -O $SRC_URI/sw/oss/$APN/src/$T
}

do_unpack(){
  tar xvf $T
}

do_configure(){
  ./configure --prefix=$DST/$APN-$V \
    --with-config-file-path=/usr/local/etc/php${V%%.*}/ \
    --with-pdo-pgsql \
    --with-pdo-mysql \
    --with-pgsql \
    --with-mysqli \
    --enable-mbstring \
    --with-openssl \
    --with-ldap \
    --enable-bcmath \
    --enable-sockets \
    --enable-exif \
    --enable-intl \
    --with-gettext \
    --enable-gd \
    --with-jpeg \
    --with-freetype \
    --with-curl \
    --with-zip \
    --with-zlib \
    --with-gmp \
    --with-snmp \
    --enable-fpm \
    --with-fpm-systemd \
    --with-fpm-acl \
    --with-bz2 \
    --enable-ftp \
    --enable-pcntl \
    --enable-sysvsem \
    --enable-sysvshm \
    --enable-sysvmsg
}

do_build(){
  make
}

do_install(){
  make install
  ln -snfvr $DST/$APN{-$V,-${V%.*}}

  mkdir -pv $DST/$APN-$V/etc/php
  cp -vf php.ini-development php.ini-production $DST/$APN-$V/etc/php
}

do_verify(){
  php -v
  php -m
}

do_misc(){
  cd $SRC
  curl $SRC_OPT -O $SRC_URI/sw/oss/$APN/ext/apcu-$VER_EXT_APCU.tar.gz
  tar xvf apcu-$VER_EXT_APCU.tar.gz
  cd apcu-$VER_EXT_APCU
  phpize
  ./configure
  make
  make install
}

do_save(){
  cd $DST
  tar cvf $SRC/$APN-$V-$OSN-$OSA.tar $APN-$V
  gzip -f $SRC/$APN-$V-$OSN-$OSA.tar
}

do_push(){
  scp -q $SRC/$APN-$V-$OSN-$OSA.tar.gz $DST_URI/sw/oss/$APN/bin/
}
