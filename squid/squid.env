: ${INFO:="Squid"}

: ${T=squid-$V.tar.gz}
: ${S=$SRC/squid-$V}

PATH=$DST/$APN-$V/sbin:$PATH

do_init(){
  if [[ "$OSN" =~ ^debian ]]; then
    apt update
    apt install -y libssl-dev libxml2-dev libcap-dev libldap2-dev
  fi
}

do_pull(){
  curl $SRC_OPT -O $SRC_URI/sw/oss/$APN/src/$T
}

do_unpack(){
  tar xvf $T
}

do_configure(){
  ./configure --prefix=$DST/$APN-$V \
    --enable-icmp \
    --enable-delay-pools \
    --enable-useragent-log \
    --localstatedir=/var \
    --with-logdir=/var/log/squid \
    --with-pidfile=/var/run/squid.pid \
    --with-default-user=squid
}

do_build(){
  make
}

do_install(){
  make install
  ln -snfvr $DST/$APN{-$V,}
}

do_verify(){
  squid -v 2>&1 | sed 's/--/\n  --/g'
}

do_misc(){
  cd $DST/$APN/share/errors
  curl $SRC_OPT $SRC_URI/sw/oss/$APN/src/squid-langpack-$VER_LANG.tar.gz | tar xzf -
  ./alias-link.sh ln rm . aliases
}

do_save(){
  cd $DST
  tar cvf $SRC/$APN-$V-$OSN-$OSA.tar $APN-$V
  gzip -f $SRC/$APN-$V-$OSN-$OSA.tar
}

do_push(){
  scp -q $SRC/$APN-$V-$OSN-$OSA.tar.gz $DST_URI/sw/oss/$APN/bin/
}
