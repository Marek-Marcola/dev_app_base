: ${INFO:="PostgreSQL"}

T=postgresql-$V.tar.gz
S=$SRC/postgresql-$V

PATH=$DST/$APN-$V/bin:$PATH

do_init(){
  if [[ "$OSN" =~ ^debian ]]; then
    apt update
    apt install -y gcc bison flex
    apt install -y libreadline-dev zlib1g-dev libgettextpo-dev libicu-dev
    apt install -y libssl-dev libkrb5-dev libldap2-dev libpam0g-dev
    apt install -y libxml2-utils pkg-config
  fi
  if [[ "$OSN" =~ ^rocky ]]; then
    yum install -y gcc bison flex
    yum install -y readline-devel zlib-devel gettext-devel
    yum install -y openssl-devel krb5-devel openldap-devel pam-devel libicu-devel
    yum install -y perl-FindBin perl-File-Compare
  fi
}

do_pull(){
  curl $SRC_OPT -O $SRC_URI/sw/oss/$APN/src/$T
}

do_unpack(){
  tar xvf $T
}

do_configure(){
  ./configure --prefix=$DST/$APN-$V \
    --enable-thread-safety \
    --with-ssl=openssl \
    --with-gssapi \
    --with-ldap \
    --with-pam
}

do_build(){
  make
}

do_install(){
  make install
  make install-docs || true
  ln -snfvr $DST/$APN{-$V,-${V%.*}}
}

do_verify(){
  pg_config
  postgres -V
}

do_misc(){
  cd contrib
  make all
  make install
}

do_save(){
  cd $DST
  tar cvf $SRC/$APN-$V-$OSN-$OSA.tar $APN-$V
  gzip -f $SRC/$APN-$V-$OSN-$OSA.tar
}

do_push(){
  scp -q $SRC/$APN-$V-$OSN-$OSA.tar.gz $DST_URI/sw/oss/$APN/bin/
}
